// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`baseline was N (spec 05 §5.3) > pins the SQL of both predicates 1`] = `
[
  "isModified(3)
  EXISTS ( SELECT 1 FROM ( SELECT s.* FROM "Requirement" s JOIN "Baseline" b ON b.id = s."baselineId" WHERE s."spaceId" = r."spaceId" AND ( s."upperKey" = r."upperKey" OR EXISTS ( SELECT 1 FROM "RequirementKeyAlias" ka WHERE ka."requirementId" = r.id AND ka."spaceId" = s."spaceId" AND ka."upperKey" = s."upperKey" ) ) AND b.number = $1 ) snap WHERE snap.title IS DISTINCT FROM r.title OR snap."bodySearch" IS DISTINCT FROM r."bodySearch" OR ( SELECT COALESCE(string_agg(p."searchName" || '=' || p.value, chr(31) ORDER BY p."searchName", p."valueIndex", p.value), '') FROM "Property" p WHERE p."requirementId" = snap.id AND p.kind = 'INLINE' ) IS DISTINCT FROM ( SELECT COALESCE(string_agg(p."searchName" || '=' || p.value, chr(31) ORDER BY p."searchName", p."valueIndex", p.value), '') FROM "Property" p WHERE p."requirementId" = r.id AND p.kind = 'INLINE' ) )
  params: [3]",
  "isModified('Release 1.3c')
  EXISTS ( SELECT 1 FROM ( SELECT s.* FROM "Requirement" s JOIN "Baseline" b ON b.id = s."baselineId" WHERE s."spaceId" = r."spaceId" AND ( s."upperKey" = r."upperKey" OR EXISTS ( SELECT 1 FROM "RequirementKeyAlias" ka WHERE ka."requirementId" = r.id AND ka."spaceId" = s."spaceId" AND ka."upperKey" = s."upperKey" ) ) AND b.name = $1 ) snap WHERE snap.title IS DISTINCT FROM r.title OR snap."bodySearch" IS DISTINCT FROM r."bodySearch" OR ( SELECT COALESCE(string_agg(p."searchName" || '=' || p.value, chr(31) ORDER BY p."searchName", p."valueIndex", p.value), '') FROM "Property" p WHERE p."requirementId" = snap.id AND p.kind = 'INLINE' ) IS DISTINCT FROM ( SELECT COALESCE(string_agg(p."searchName" || '=' || p.value, chr(31) ORDER BY p."searchName", p."valueIndex", p.value), '') FROM "Property" p WHERE p."requirementId" = r.id AND p.kind = 'INLINE' ) )
  params: ["Release 1.3c"]",
  "baseline was 3
  EXISTS ( SELECT s.* FROM "Requirement" s JOIN "Baseline" b ON b.id = s."baselineId" WHERE s."spaceId" = r."spaceId" AND ( s."upperKey" = r."upperKey" OR EXISTS ( SELECT 1 FROM "RequirementKeyAlias" ka WHERE ka."requirementId" = r.id AND ka."spaceId" = s."spaceId" AND ka."upperKey" = s."upperKey" ) ) AND b.number = $1 )
  params: [3]",
]
`;
