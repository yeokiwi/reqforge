# PostgreSQL 16. `docker compose up -d db` provides exactly this.
DATABASE_URL="postgresql://reqforge:reqforge@localhost:5432/reqforge?schema=public"
# Used for tests that need a throwaway database.
TEST_DATABASE_URL="postgresql://reqforge:reqforge@localhost:5432/reqforge_test?schema=public"
# Where job results (xlsx exports) are written. Served only through a permission check.
REQFORGE_STORAGE_DIR=".storage"
# 1 runs queued jobs in the web process; `pnpm worker` runs them in their own process.
JOBS_INLINE="1"
# 32+ random bytes, base64. Signs session cookies.
SESSION_SECRET="change-me-in-production-0000000000000000"
