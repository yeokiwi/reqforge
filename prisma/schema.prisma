// Reqforge data model — draft for slice 0/1.
// Spec: docs/specs/01-domain-model.md. Invariants the schema cannot express are
// enforced in src/server/repositories/** and by the SQL in prisma/migrations/**.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  /// scrypt, "scrypt$N$r$p$salt$hash" — see src/server/auth/password.ts
  passwordHash String
  isAdmin      Boolean      @default(false)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  apiTokens    ApiToken[]
  sessions     Session[]
}

/// Server-side session record. The cookie carries the id plus an HMAC of it;
/// expiry and revocation are decided here, never by the client.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Group {
  id      String        @id @default(cuid())
  name    String        @unique
  members GroupMember[]
}

model GroupMember {
  groupId String
  userId  String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

/// A machine credential (spec 08 §1; RD-065). The plaintext `rf_<id>_<secret>` is shown
/// once; only a SHA-256 of the secret is kept. Effective rights are always the
/// intersection of `scopes` and the owner's live space permissions, so revoking a person
/// revokes their tokens.
model ApiToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  hash      String    @unique
  /// Subset of read | edit | export | admin — never more than the owner holds.
  scopes    String[]
  /// Space keys the token is confined to; empty means every space the owner may see.
  spaceKeys String[]  @default([])
  lastUsed  DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------- space

model Space {
  id                   String               @id @default(cuid())
  key                  String               @unique // [A-Z][A-Z0-9]{1,15}
  name                 String
  isolated             Boolean              @default(false) // research §6.6
  globalKeys           Boolean              @default(false) // research §2.2
  /// spec 07 §2.3 — a level from the instance's ordered list (RD-060), never free text,
  /// so "the highest label" is always defined.
  classificationId     String?
  classification       ClassificationLevel? @relation("SpaceClassification", fields: [classificationId], references: [id], onDelete: SetNull)
  historyEnabled       Boolean              @default(false) // research §2.7 — off by default
  /// Null keeps history for ever. Pruning never removes a row dated at or before the
  /// freeze of a baseline that contains the requirement — spec 05 §6, RD-049.
  historyRetentionDays Int?
  limits               Json? // per-space overrides of spec 07 §4
  /// Monotonic. Invariant B2: a baseline number is never reused, including after
  /// deletion, so it comes from a counter that only moves forward — never from
  /// max(number) over the rows that happen to remain.
  nextBaselineNumber   Int                  @default(1)

  documents       Document[]
  requirements    Requirement[]
  keyAliases      RequirementKeyAlias[]
  baselines       Baseline[]
  types           RequirementType[]
  matrices        SavedMatrix[]
  searches        SavedSearch[]
  coverageTargets CoverageTarget[]
  webhooks        Webhook[]
  memberships     Membership[]
  createdAt       DateTime              @default(now())
}

model Membership {
  id          String            @id @default(cuid())
  spaceId     String
  space       Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId     String?
  permissions SpacePermission[]

  @@unique([spaceId, userId, groupId])
}

enum SpacePermission {
  VIEW
  EDIT
  EXPORT
  ADMIN
}

// ---------------------------------------------------------------- documents

model Document {
  id                String                @id @default(cuid())
  spaceId           String
  space             Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parentId          String?
  parent            Document?             @relation("DocTree", fields: [parentId], references: [id])
  children          Document[]            @relation("DocTree")
  title             String
  ordinal           Int                   @default(0)
  classificationId  String?
  classification    ClassificationLevel?  @relation("DocumentClassification", fields: [classificationId], references: [id], onDelete: SetNull)
  /// INHERIT: no list of its own, but every restricted ancestor still gates it (RD-056).
  restrictionMode   RestrictionMode       @default(INHERIT) // spec 07 §2.2
  currentVersionId  String?               @unique
  versions          DocumentVersion[]     @relation("DocVersions")
  restrictions      DocumentRestriction[]
  viewGates         DocumentViewGate[]    @relation("GatedDocument")
  gatesFor          DocumentViewGate[]    @relation("GateDocument")
  diagnostics       IndexDiagnostic[]     @relation("DiagnosticDocument")
  causedDiagnostics IndexDiagnostic[]     @relation("DiagnosticRelated")
  createdAt         DateTime              @default(now())
  deletedAt         DateTime?

  @@index([spaceId, parentId, ordinal])
}

enum RestrictionMode {
  INHERIT
  EXPLICIT
}

model DocumentRestriction {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String?
  groupId    String?
  canView    Boolean  @default(true)
  canEdit    Boolean  @default(false)

  @@unique([documentId, userId, groupId])
  @@index([documentId, canView])
  @@index([documentId, canEdit])
}

/// Rule X1 with inheritance (RD-056): one row per restricted ancestor-or-self of a
/// document. A reader sees the document only if every gate's own view list admits them,
/// so the visibility predicate stays one indexed NOT EXISTS instead of a recursive walk.
/// Derived data: rebuilt for a subtree whenever a restriction changes or a document is
/// created or moved (`repositories/restrictions.ts#rebuildGates`).
model DocumentViewGate {
  documentId     String
  document       Document @relation("GatedDocument", fields: [documentId], references: [id], onDelete: Cascade)
  gateDocumentId String
  gateDocument   Document @relation("GateDocument", fields: [gateDocumentId], references: [id], onDelete: Cascade)

  @@id([documentId, gateDocumentId])
  @@index([gateDocumentId])
}

/// Immutable. Never deleted while `pinned` (invariant D1, spec 05 §3.2 step 6).
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation("DocVersions", fields: [documentId], references: [id], onDelete: Cascade)
  number     Int
  content    Json // ProseMirror JSON
  authorId   String
  message    String?
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())

  requirements Requirement[]
  links        DocumentLink[]

  @@unique([documentId, number])
}

/// Indexer output that is not a requirement: the diagnostics catalogue of spec 03 §7.
/// Rewritten whenever the document is indexed. A KEY_CONFLICT (rule S3) writes one row
/// against each document involved, with `relatedDocument` pointing at the other, so both
/// editors see it and neither definition is hidden.
model IndexDiagnostic {
  id                String    @id @default(cuid())
  documentId        String
  document          Document  @relation("DiagnosticDocument", fields: [documentId], references: [id], onDelete: Cascade)
  versionId         String?
  code              String
  severity          String // 'error' | 'warning'
  message           String
  path              String
  key               String?
  /// The quick fix, as data (spec 06 §4, RD-042), so a reload keeps its Fix button.
  fix               Json?
  relatedDocumentId String?
  relatedDocument   Document? @relation("DiagnosticRelated", fields: [relatedDocumentId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())

  @@index([documentId])
  @@index([relatedDocumentId])
  @@index([code])
}

// ---------------------------------------------------------------- requirements

enum RequirementStatus {
  ACTIVE
  ARCHIVED
  MOVED
  DELETED
}

/// Logical identity is (spaceId, upperKey, baselineId) — RD-001.
/// baselineId NULL => live. Rows with baselineId set are immutable (invariant R2),
/// enforced by a trigger in the migration, not by application code.
model Requirement {
  id         String    @id @default(cuid())
  spaceId    String
  space      Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  key        String
  upperKey   String
  baselineId String?
  /// Deleting a baseline deletes its frozen rows; nulling them would break invariant R1.
  baseline   Baseline? @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  status          RequirementStatus @default(ACTIVE)
  title           String
  bodyHtml        String
  bodySearch      String
  anchorPath      String
  uid             String // stable marker id, survives rename
  originVersionId String?
  originVersion   DocumentVersion?  @relation(fields: [originVersionId], references: [id])

  typeId String?
  type   RequirementType? @relation(fields: [typeId], references: [id])

  // Forwarding pointers for a cross-space *move* (status = MOVED). A move is a different
  // operation from a rename and is not implemented — RD-055.
  newKey      String?
  newSpaceId  String?
  /// The immediately previous key, for display. The full chain lives in
  /// `RequirementKeyAlias` — one column cannot survive a second rename (RD-051).
  renamedFrom String?

  properties  Property[]
  parentEdges Dependency[]            @relation("AsChild")
  childEdges  Dependency[]            @relation("AsParent")
  unresolved  UnresolvedDependency[]
  links       DocumentLink[]
  validations RequirementValidation[]
  labels      RequirementLabel[]
  history     RequirementHistory[]
  keyAliases  RequirementKeyAlias[]

  createdAt   DateTime @default(now())
  createdById String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  // Invariant R1. The NULL-collision half is a partial unique index in the migration:
  //   CREATE UNIQUE INDEX ... ON "Requirement" ("spaceId","upperKey")
  //     WHERE "baselineId" IS NULL;
  @@unique([spaceId, upperKey, baselineId])
  @@index([spaceId, baselineId, status])
  @@index([baselineId])
  /// Every baseline read is scoped to one baseline; freeze looks members up by key.
  @@index([baselineId, upperKey])
  @@index([originVersionId])
}

/// Every key a live requirement has ever had, so a rename never orphans a reference.
/// `Requirement.renamedFrom` holds only the last hop; after FN-1 -> FN-2 -> FN-3 the key
/// FN-1 would be lost, which contradicts the *chain* RD-007 promises. RD-051.
///
/// The unique index is also the rename's collision check: a key still claimed by an alias
/// is not free to reuse, so a stale link can never silently land on a different
/// requirement.
model RequirementKeyAlias {
  id            String      @id @default(cuid())
  spaceId       String
  space         Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  key           String
  upperKey      String
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  renamedAt     DateTime    @default(now())
  actorId       String
  jobId         String?

  @@unique([spaceId, upperKey])
  @@index([requirementId])
}

enum PropertyKind {
  INLINE
  EXTERNAL
}

model Property {
  id            String                      @id @default(cuid())
  requirementId String
  requirement   Requirement                 @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  kind          PropertyKind
  name          String
  searchName    String // RD-011
  value         String
  valueOrdinal  Int                         @default(0) // column order
  valueIndex    Int                         @default(0) // list member index
  definitionId  String?
  definition    ExternalPropertyDefinition? @relation(fields: [definitionId], references: [id])

  @@index([requirementId, kind])
  @@index([requirementId, searchName, value]) // spec 07 §5 — traversal targets, RD-073
  @@index([searchName, value])
  /// "is this definition still in use?" — deletion is refused while values exist.
  @@index([definitionId])
}

/// Instance-global, not space-scoped — research §2.6.
model ExternalPropertyDefinition {
  id          String     @id @default(cuid())
  name        String     @unique
  dataType    DataType
  enumValues  String[]
  description String?
  values      Property[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum DataType {
  STRING
  TEXT
  NUMBER
  BOOLEAN
  DATE
  ENUM
}

model RequirementLabel {
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  label         String

  @@id([requirementId, label])
  @@index([label])
}

// ---------------------------------------------------------------- links

/// Invariant P1: the requirement containing the link is the CHILD.
model Dependency {
  relationship     String
  parentId         String
  childId          String
  parent           Requirement @relation("AsParent", fields: [parentId], references: [id], onDelete: Cascade)
  child            Requirement @relation("AsChild", fields: [childId], references: [id], onDelete: Cascade)
  /// Pin to a baseline of the target — research §4.1
  targetBaselineId String?

  @@id([relationship, parentId, childId])
  @@index([childId])
  @@index([parentId])
}

/// Invariant P2: never cascade-delete a dependency because its target vanished.
model UnresolvedDependency {
  id               String      @id @default(cuid())
  childId          String
  child            Requirement @relation(fields: [childId], references: [id], onDelete: Cascade)
  relationship     String
  targetSpaceKey   String
  targetKey        String
  targetBaselineId String?

  @@index([childId])
  @@index([targetSpaceKey, targetKey])
}

/// origin = true for the defining occurrence — mirrors RY's DBLINK.ORIGIN.
model DocumentLink {
  id            String          @id @default(cuid())
  requirementId String
  requirement   Requirement     @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  versionId     String
  version       DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  origin        Boolean         @default(false)
  anchorPath    String?

  @@index([requirementId])
  @@index([versionId])
}

// ---------------------------------------------------------------- baselines

enum BaselineState {
  DRAFT
  FROZEN
}

model Baseline {
  id                   String               @id @default(cuid())
  spaceId              String
  space                Space                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  number               Int // sequential, immutable, never reused (invariant B2)
  name                 String
  state                BaselineState        @default(DRAFT)
  sourceQuery          String
  includedDependencies Boolean              @default(false)
  includedExternal     Boolean              @default(false) // RD-010
  reportDocumentId     String?
  frozenAt             DateTime?
  frozenById           String?
  createdAt            DateTime             @default(now())
  createdById          String?
  /// spec 07 §2.3 — the highest label among the members, captured at freeze (RD-060).
  classificationId     String?
  classification       ClassificationLevel? @relation("BaselineClassification", fields: [classificationId], references: [id], onDelete: SetNull)

  requirements Requirement[]
  revisions    BaselineRevision[]
  dangling     BaselineDanglingDependency[]
  viewGates    BaselineViewGate[]
  gateGrants   BaselineGateGrant[]

  @@unique([spaceId, number])
  @@index([spaceId, state])
}

/// Rule X4 (RD-059): the gates of each member's origin document as they stood at freeze.
/// A frozen row must pass these *and* the current gates, so loosening a document later
/// never exposes baselined text, while tightening it applies at once.
model BaselineViewGate {
  baselineId     String
  baseline       Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  documentId     String
  gateDocumentId String

  @@id([baselineId, documentId, gateDocumentId])
  @@index([baselineId, documentId])
}

/// The view grants of a frozen gate, as they stood at freeze (RD-059).
model BaselineGateGrant {
  id             String   @id @default(cuid())
  baselineId     String
  baseline       Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  gateDocumentId String
  userId         String?
  groupId        String?

  @@index([baselineId, gateDocumentId])
}

model BaselineRevision {
  id          String   @id @default(cuid())
  baselineId  String
  baseline    Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  at          DateTime @default(now())
  actorId     String
  reason      String
  countBefore Int
  countAfter  Int
  detail      Json
}

/// Dependencies that pointed outside the member set at freeze time — spec 05 §3.2 step 5.
model BaselineDanglingDependency {
  id           String   @id @default(cuid())
  baselineId   String
  baseline     Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  childKey     String
  relationship String
  targetKey    String
}

// ---------------------------------------------------------------- types

model RequirementType {
  id                        String  @id @default(cuid())
  spaceId                   String
  space                     Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name                      String? // null => bare key suggestion (research §2.3)
  keyPattern                String // e.g. "FN-###"
  colour                    String  @default("#4a5568")
  locked                    Boolean @default(false)
  nextSequence              Int     @default(1)
  preventReusingDeletedKeys Boolean @default(true)

  rules           RequirementTypeRule[]
  templateColumns TemplateColumn[]
  requirements    Requirement[]
  validations     RequirementValidation[]

  @@unique([spaceId, keyPattern])
}

enum RuleKind {
  REQUIRED_PROPERTY
  OPTIONAL_PROPERTY
  REQUIRED_DEPENDENCY
  PROPERTY_MATCHES // RD-015
  PROPERTY_IN // RD-015
}

model RequirementTypeRule {
  id           String          @id @default(cuid())
  typeId       String
  type         RequirementType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  kind         RuleKind
  name         String?
  relationship String?
  direction    String? // 'to' | 'from'
  pattern      String?
  values       String[]
  ordinal      Int             @default(0)
}

model TemplateColumn {
  id       String          @id @default(cuid())
  typeId   String
  type     RequirementType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  name     String
  required Boolean         @default(false)
  ordinal  Int             @default(0)
}

enum ValidationStatus {
  TRUE
  FALSE
  WARNING
}

model RequirementValidation {
  requirementId String
  requirement   Requirement      @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  typeId        String
  type          RequirementType  @relation(fields: [typeId], references: [id], onDelete: Cascade)
  status        ValidationStatus
  messages      Json
  computedAt    DateTime         @default(now())

  @@id([requirementId, typeId])
  @@index([typeId, status])
}

// ---------------------------------------------------------------- matrices, jobs, audit

enum MatrixKind {
  TRACEABILITY
  DEPENDENCY
}

model SavedMatrix {
  id         String     @id @default(cuid())
  spaceId    String
  space      Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name       String
  kind       MatrixKind
  query      String
  columns    Json
  visibility String     @default("space") // private | space | public-link
  ownerId    String
  createdAt  DateTime   @default(now())

  @@unique([spaceId, name])
}

/// A per-space target coverage percentage for one relationship and direction.
/// spec: 04-traceability-and-coverage.md §4.2 — "A target coverage threshold per
/// relationship can be set per space; below it the row is flagged." No RY equivalent.
model CoverageTarget {
  id            String   @id @default(cuid())
  spaceId       String
  space         Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  relationship  String
  direction     String // 'to' | 'from'
  targetPercent Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([spaceId, relationship, direction])
  @@index([spaceId])
}

/// A named RQL query. Saved searches are per space and owned by a user; visibility
/// matches SavedMatrix so one sharing model covers both.
model SavedSearch {
  id         String   @id @default(cuid())
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name       String
  query      String
  visibility String   @default("space") // private | space
  ownerId    String
  createdAt  DateTime @default(now())

  @@unique([spaceId, name])
  @@index([spaceId, ownerId])
}

enum JobState {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

model Job {
  id              String    @id @default(cuid())
  kind            String
  spaceId         String?
  payload         Json
  state           JobState  @default(QUEUED)
  progress        Int       @default(0)
  message         String?
  error           String?
  resultRef       String?
  cancelRequested Boolean   @default(false)
  actorId         String
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  /// spec 03 §5 — a rename ends with an explicit acknowledgement, so its outcome stays on
  /// screen until the person who ran it has read it.
  acknowledgedAt  DateTime?

  @@index([state, createdAt])
}

model RequirementHistory {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  /// Denormalised: this is the fastest-growing table, and pruning reads it by space.
  spaceId       String?
  at            DateTime    @default(now())
  actorId       String
  changeKind    String
  before        Json?
  after         Json?

  @@index([requirementId, at])
  @@index([actorId, at])
  @@index([requirementId, changeKind, at])
  @@index([spaceId, at])
}

/// Append-only. Never pruned by history retention — spec 07 §6.
model AuditEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String
  spaceId    String?
  objectType String
  objectId   String
  operation  String
  parameters Json

  @@index([spaceId, at])
  @@index([objectType, objectId, at])
}

/// spec 07 §2.3 — "free text configured per installation", ordered so that "the highest
/// label" is defined (RD-060). Higher `rank` is more restrictive. Instance admins own it.
model ClassificationLevel {
  id        String   @id @default(cuid())
  name      String   @unique
  rank      Int      @unique
  createdAt DateTime @default(now())

  spaces    Space[]    @relation("SpaceClassification")
  documents Document[] @relation("DocumentClassification")
  baselines Baseline[] @relation("BaselineClassification")
}

/// An outbound webhook subscription for one space (spec 08 §7; RD-066, RD-067).
model Webhook {
  id          String   @id @default(cuid())
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  url         String
  /// HMAC key for `X-Reqforge-Signature`; shown once when created.
  secret      String
  /// Event types subscribed to; empty means every type.
  events      String[]
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([spaceId, active])
}

enum WebhookDeliveryState {
  PENDING
  DELIVERED
  DEAD
}

/// The transactional outbox (RD-067): written in the same transaction as the change it
/// describes, so a rolled-back change emits nothing. Payloads are thin (RD-066).
model WebhookEvent {
  id        String   @id @default(cuid())
  spaceId   String
  type      String
  recordId  String?
  payload   Json
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([spaceId, createdAt])
}

/// One attempt stream of one event to one subscription (RD-067).
model WebhookDelivery {
  id            String               @id @default(cuid())
  webhookId     String
  webhook       Webhook              @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventId       String
  event         WebhookEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  state         WebhookDeliveryState @default(PENDING)
  attempt       Int                  @default(0)
  nextAttemptAt DateTime             @default(now())
  lastStatus    Int?
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime             @default(now())

  @@index([state, nextAttemptAt])
  @@index([webhookId, state])
}
