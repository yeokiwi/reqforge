// Reqforge data model — draft for slice 0/1.
// Spec: docs/specs/01-domain-model.md. Invariants the schema cannot express are
// enforced in src/server/repositories/** and by the SQL in prisma/migrations/**.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  name             String
  /// scrypt, `scrypt$N$r$p$salt$hash` — see src/server/auth/password.ts (RD-050).
  passwordHash     String
  /// Administration, the Queue, global property definitions. Grants no access to space
  /// content: space permissions are separate (RD-051).
  isInstanceAdmin  Boolean             @default(false)
  /// Remembered per user — spec 10 §3.2 (`«` / `»`).
  sidebarCollapsed Boolean             @default(false)
  createdAt        DateTime            @default(now())
  memberships      Membership[]
  groupMemberships GroupMember[]
  apiTokens        ApiToken[]
  sessions         Session[]
  spaceStates      UserSpaceState[]
  createdDocuments Document[]          @relation("DocumentCreator")
  versionsAuthored DocumentVersion[]   @relation("VersionAuthor")
  drafts           DocumentDraft[]
  watches          DocumentWatch[]
  favouriteDocs    DocumentFavourite[]
  presence         DocumentPresence[]
  attachments      Attachment[]
}

model Group {
  id          String        @id @default(cuid())
  name        String        @unique
  members     GroupMember[]
  memberships Membership[]
}

model GroupMember {
  groupId String
  userId  String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

/// Server-side session. Only the SHA-256 of the cookie value is stored, so a database
/// read does not yield usable credentials (RD-050).
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Per-user, per-space UI state: the sidebar star (spec 10 §3.2) and the "recent spaces"
/// list in the `Spaces ▾` menu (spec 10 §2).
model UserSpaceState {
  userId       String
  spaceId      String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  space        Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  favourite    Boolean   @default(false)
  lastViewedAt DateTime?

  @@id([userId, spaceId])
  @@index([userId, lastViewedAt])
}

model ApiToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  hash      String    @unique
  scopes    String[]
  lastUsed  DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

// ---------------------------------------------------------------- space

model Space {
  id                        String  @id @default(cuid())
  key                       String  @unique // [A-Z][A-Z0-9]{1,15}
  name                      String
  isolated                  Boolean @default(false) // research §6.6
  globalKeys                Boolean @default(false) // research §2.2 — "Generate global keys"
  // Key-suggestion settings, RY defaults (spec 03 §4.2, RD-042)
  useGlobalKeySettings      Boolean @default(true)
  linksAcrossSpaces         Boolean @default(true)
  preventReusingDeletedKeys Boolean @default(false)
  lockKeys                  Boolean @default(false)
  classification            String? // e.g. "Official (Closed)" — spec 07 §2.3
  historyEnabled            Boolean @default(false) // research §2.7 — off by default
  limits                    Json? // per-space overrides of spec 07 §4

  documents      Document[]
  requirements   Requirement[]
  baselines      Baseline[]
  types          RequirementType[]
  keySuggestions KeySuggestion[]
  matrices       SavedMatrix[]
  memberships    Membership[]
  userStates     UserSpaceState[]
  createdAt      DateTime          @default(now())
}

/// Exactly one of userId / groupId is set. Postgres treats NULLs as distinct, so the
/// "exactly one" CHECK and the two partial unique indexes live in the migration SQL.
model Membership {
  id          String            @id @default(cuid())
  spaceId     String
  space       Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permissions SpacePermission[]

  @@index([spaceId])
  @@index([userId])
  @@index([groupId])
}

enum SpacePermission {
  VIEW
  EDIT
  EXPORT
  ADMIN
}

/// Single row — Administration → Options (spec 10 §19.1, 07 §2.4).
model InstanceSettings {
  id                        Int      @id @default(1)
  globalLimit               Int      @default(12000) // per operation, not per space
  renameGroups              String[] // empty => space admins only
  baselineDeletionGroups    String[] // empty => space admins only
  exportForAllViewers       Boolean  @default(true)
  // instance-level key-suggestion defaults, inherited while a space has useGlobalKeySettings
  linksAcrossSpaces         Boolean  @default(true)
  preventReusingDeletedKeys Boolean  @default(false)
  globalKeys                Boolean  @default(false)
  lockKeys                  Boolean  @default(false)
  updatedAt                 DateTime @updatedAt
}

/// Last 10 queries per user — spec 10 §9.2.
model QueryHistory {
  id      String   @id @default(cuid())
  userId  String
  spaceId String
  query   String
  at      DateTime @default(now())

  @@index([userId, spaceId, at])
}

// ---------------------------------------------------------------- documents

model Document {
  id               String                @id @default(cuid())
  spaceId          String
  space            Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parentId         String?
  parent           Document?             @relation("DocTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Document[]            @relation("DocTree")
  /// Current title. Unique per space among live documents, case-insensitively — partial
  /// unique index in the migration (RD-056). Every version also records its own title.
  title            String
  /// Position among siblings, dense 0..n-1 (RD-056).
  ordinal          Int                   @default(0)
  classification   String?
  restrictionMode  RestrictionMode       @default(NONE) // the three modes of the Restrictions dialog — spec 10 §10, 07 §2.2
  currentVersionId String?               @unique
  /// Never deletable while current (ON DELETE RESTRICT).
  currentVersion   DocumentVersion?      @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  versions         DocumentVersion[]     @relation("DocVersions")
  restrictions     DocumentRestriction[]
  drafts           DocumentDraft[]
  watchers         DocumentWatch[]
  favourites       DocumentFavourite[]
  presence         DocumentPresence[]
  attachments      Attachment[]
  createdById      String
  createdBy        User                  @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime              @default(now())
  /// Soft delete (RD-056): a deleted page and its whole subtree are hidden together.
  deletedAt        DateTime?
  deletedById      String?
  /// The page the user actually deleted; its descendants carry the same value, so the
  /// subtree can be restored as a unit (Trash, slice 16a).
  deletedRootId    String?

  @@index([spaceId, parentId, ordinal])
  @@index([spaceId, deletedAt])
}

enum RestrictionMode {
  NONE // "No restrictions"
  EDIT_RESTRICTED // "Editing restricted"
  VIEW_EDIT_RESTRICTED // "Viewing and editing restricted"
}

model DocumentRestriction {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String?
  groupId    String?
  canView    Boolean  @default(true)
  canEdit    Boolean  @default(false)

  @@unique([documentId, userId, groupId])
}

/// Immutable. Never deleted while `pinned` (invariant D1, spec 05 §3.2 step 6). Only `pinned`
/// may change after insert; a trigger in the migration enforces both rules.
model DocumentVersion {
  id         String    @id @default(cuid())
  documentId String
  document   Document  @relation("DocVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentOf  Document? @relation("CurrentVersion")
  /// Sequential per document. The current version is never deleted, so MAX+1 never reuses one.
  number     Int
  /// The title as of this version (a rename is a new version — RD-056).
  title      String
  /// Canonical ProseMirror JSON: normalised through the editor schema before storage (RD-055).
  content    Json
  authorId   String
  author     User      @relation("VersionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  /// The editor footer's `What did you change?` (10 §5.1), shown in Page history (10 §23).
  message    String?
  pinned     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  requirements Requirement[]
  links        DocumentLink[]

  @@unique([documentId, number])
}

/// Autosaved work in progress: mutable, one per (document, user). `Update` turns it into a
/// DocumentVersion; `Close` keeps it; `Revert to last published` deletes it (RD-055).
model DocumentDraft {
  documentId        String
  userId            String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  content           Json
  /// The version number this draft started from. Stale when it no longer equals the current one.
  baseVersionNumber Int
  updatedAt         DateTime @updatedAt

  @@id([documentId, userId])
}

/// `Watching` (10 §4.1). On by default for the author. Email delivery is not built (RD-061).
model DocumentWatch {
  documentId String
  userId     String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([documentId, userId])
  @@index([userId])
}

/// `Save for later` (10 §4.1): personal favourites.
model DocumentFavourite {
  documentId String
  userId     String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([documentId, userId])
  @@index([userId])
}

/// Who has the page open (10 §5.1 presence avatars). Heartbeat-driven; rows older than the
/// presence window are ignored and pruned opportunistically (RD-062).
model DocumentPresence {
  documentId String
  userId     String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime

  @@id([documentId, userId])
  @@index([documentId, lastSeenAt])
}

/// Files and images on a page (RD-058). Bytes live in the database, content-addressed by
/// `sha256`, so baseline freeze can later copy images by hash (RD-012). `deletedAt` hides an
/// attachment from the page's list but keeps the bytes: past versions still reference them.
model Attachment {
  id           String    @id @default(cuid())
  documentId   String
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  filename     String
  contentType  String
  size         Int
  sha256       String
  data         Bytes
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([documentId, deletedAt])
  @@index([sha256])
}

// ---------------------------------------------------------------- requirements

enum RequirementStatus {
  ACTIVE
  ARCHIVED
  MOVED
  DELETED
}

/// Spec 03 §2. HEADING comes from the vendor screencast, not the written docs.
enum RequirementLayout {
  TABLE_ROW
  TABLE_COLUMN
  PARAGRAPH
  HEADING
}

/// Logical identity is (spaceId, upperKey, baselineId) — RD-001.
/// baselineId NULL => live. Rows with baselineId set are immutable (invariant R2),
/// enforced by a trigger in the migration, not by application code.
model Requirement {
  id         String    @id @default(cuid())
  spaceId    String
  space      Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// NFC-normalised. Any Unicode except / and \ — see spec 03 §4.1 and RD-023.
  key        String
  /// Unicode CASE-FOLDED, not uppercased. Postgres: lower(key) with an ICU collation.
  upperKey   String
  baselineId String?
  baseline   Baseline? @relation(fields: [baselineId], references: [id])

  status          RequirementStatus @default(ACTIVE)
  title           String
  bodyHtml        String
  bodySearch      String
  anchorPath      String
  uid             String // stable marker id, survives rename
  layout          RequirementLayout @default(TABLE_ROW)
  headingLevel    Int? // 1-6 when layout = HEADING
  sectionPath     String[] // enclosing heading titles, outermost first — RD-026
  originVersionId String?
  originVersion   DocumentVersion?  @relation(fields: [originVersionId], references: [id])

  typeId String?
  type   RequirementType? @relation(fields: [typeId], references: [id])

  // forwarding pointers when status = MOVED, and the rename chain (RD-007)
  newKey      String?
  newSpaceId  String?
  renamedFrom String?

  properties  Property[]
  parentEdges Dependency[]            @relation("AsChild")
  childEdges  Dependency[]            @relation("AsParent")
  unresolved  UnresolvedDependency[]
  links       DocumentLink[]
  validations RequirementValidation[]
  labels      RequirementLabel[]
  history     RequirementHistory[]

  createdAt   DateTime @default(now())
  createdById String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  // Invariant R1. The NULL-collision half is a partial unique index in the migration:
  //   CREATE UNIQUE INDEX ... ON "Requirement" ("spaceId","upperKey")
  //     WHERE "baselineId" IS NULL;
  @@unique([spaceId, upperKey, baselineId])
  @@index([spaceId, baselineId, status])
  @@index([baselineId])
  @@index([originVersionId])
}

enum PropertyKind {
  INLINE
  EXTERNAL
}

model Property {
  id            String                      @id @default(cuid())
  requirementId String
  requirement   Requirement                 @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  kind          PropertyKind
  name          String
  searchName    String // RD-011
  value         String
  valueOrdinal  Int                         @default(0) // column order
  valueIndex    Int                         @default(0) // list member index
  definitionId  String?
  definition    ExternalPropertyDefinition? @relation(fields: [definitionId], references: [id])

  @@index([requirementId, kind])
  @@index([searchName, value])
}

/// Instance-global, not space-scoped — research §2.6. `name` is immutable (RD-040);
/// deleting a definition deletes all its values instance-wide.
model ExternalPropertyDefinition {
  id             String     @id @default(cuid())
  name           String     @unique
  dataType       DataType
  dropdownValues String[]
  description    String?
  values         Property[]
  createdAt      DateTime   @default(now())
}

/// Exactly the five types the product shows (RD-040). Admin labels:
/// Text, Decimal number, Integer, Boolean, Dropdown.
enum DataType {
  STRING
  FLOAT
  INTEGER
  BOOLEAN
  DROPDOWN
}

model RequirementLabel {
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  label         String

  @@id([requirementId, label])
  @@index([label])
}

// ---------------------------------------------------------------- links

/// Invariant P1: the requirement containing the link is the CHILD.
model Dependency {
  relationship     String
  parentId         String
  childId          String
  parent           Requirement @relation("AsParent", fields: [parentId], references: [id], onDelete: Cascade)
  child            Requirement @relation("AsChild", fields: [childId], references: [id], onDelete: Cascade)
  /// Pin to a baseline of the target — research §4.1
  targetBaselineId String?

  @@id([relationship, parentId, childId])
  @@index([childId])
  @@index([parentId])
}

/// Invariant P2: never cascade-delete a dependency because its target vanished.
model UnresolvedDependency {
  id               String      @id @default(cuid())
  childId          String
  child            Requirement @relation(fields: [childId], references: [id], onDelete: Cascade)
  relationship     String
  targetSpaceKey   String
  targetKey        String
  targetBaselineId String?

  @@index([childId])
  @@index([targetSpaceKey, targetKey])
}

/// origin = true for the defining occurrence — mirrors RY's DBLINK.ORIGIN.
model DocumentLink {
  id            String          @id @default(cuid())
  requirementId String
  requirement   Requirement     @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  versionId     String
  version       DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  origin        Boolean         @default(false)
  anchorPath    String?

  @@index([requirementId])
  @@index([versionId])
}

// ---------------------------------------------------------------- baselines

enum BaselineState {
  DRAFT
  FROZEN
}

model Baseline {
  id                   String        @id @default(cuid())
  spaceId              String
  space                Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  number               Int // sequential, immutable, never reused (invariant B2)
  name                 String
  state                BaselineState @default(DRAFT)
  sourceQuery          String
  includedDependencies Boolean       @default(false)
  includedExternal     Boolean       @default(false) // RD-010
  reportDocumentId     String?
  frozenAt             DateTime?
  frozenById           String?
  createdAt            DateTime      @default(now())
  createdById          String?

  requirements Requirement[]
  revisions    BaselineRevision[]
  dangling     BaselineDanglingDependency[]

  @@unique([spaceId, number])
  @@index([spaceId, state])
}

model BaselineRevision {
  id          String   @id @default(cuid())
  baselineId  String
  baseline    Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  at          DateTime @default(now())
  actorId     String
  reason      String
  countBefore Int
  countAfter  Int
  detail      Json
}

/// Dependencies that pointed outside the member set at freeze time — spec 05 §3.2 step 5.
model BaselineDanglingDependency {
  id           String   @id @default(cuid())
  baselineId   String
  baseline     Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  childKey     String
  relationship String
  targetKey    String
}

// ---------------------------------------------------------------- types

/// prefix + zero-padded number + suffix — spec 03 §4.2, RD-042.
/// `number` is the LAST USED number; its length is the padding. It only advances.
model KeySuggestion {
  id      String           @id @default(cuid())
  spaceId String
  space   Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  prefix  String
  number  String           @default("001")
  suffix  String           @default("")
  type    RequirementType?

  @@unique([spaceId, prefix, suffix])
}

/// A key suggestion with a name — research §2.3.
model RequirementType {
  id              String        @id @default(cuid())
  spaceId         String
  space           Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  keySuggestionId String        @unique
  keySuggestion   KeySuggestion @relation(fields: [keySuggestionId], references: [id], onDelete: Cascade)
  name            String
  colour          String        @default("#4a5568")

  rules           RequirementTypeRule[]
  templateColumns TemplateColumn[]
  requirements    Requirement[]
  validations     RequirementValidation[]

  @@unique([spaceId, name])
}

enum RuleKind {
  REQUIRED_PROPERTY
  OPTIONAL_PROPERTY
  REQUIRED_DEPENDENCY
  PROPERTY_MATCHES // RD-015
  PROPERTY_IN // RD-015
}

model RequirementTypeRule {
  id           String          @id @default(cuid())
  typeId       String
  type         RequirementType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  kind         RuleKind
  name         String?
  relationship String?
  direction    String? // 'to' | 'from'
  pattern      String?
  values       String[]
  ordinal      Int             @default(0)
}

model TemplateColumn {
  id       String          @id @default(cuid())
  typeId   String
  type     RequirementType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  name     String
  required Boolean         @default(false)
  ordinal  Int             @default(0)
}

enum ValidationStatus {
  TRUE
  FALSE
  WARNING
}

model RequirementValidation {
  requirementId String
  requirement   Requirement      @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  typeId        String
  type          RequirementType  @relation(fields: [typeId], references: [id], onDelete: Cascade)
  status        ValidationStatus
  messages      Json
  computedAt    DateTime         @default(now())

  @@id([requirementId, typeId])
  @@index([typeId, status])
}

// ---------------------------------------------------------------- matrices, jobs, audit

enum MatrixKind {
  TRACEABILITY
  DEPENDENCY
}

model SavedMatrix {
  id         String     @id @default(cuid())
  spaceId    String
  space      Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name       String
  kind       MatrixKind
  query      String
  columns    Json
  visibility String     @default("space") // private | space | public-link
  ownerId    String
  createdAt  DateTime   @default(now())

  @@unique([spaceId, name])
}

enum JobState {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

model Job {
  id              String    @id @default(cuid())
  kind            String
  spaceId         String?
  payload         Json
  state           JobState  @default(QUEUED)
  progress        Int       @default(0)
  message         String?
  error           String?
  resultRef       String?
  cancelRequested Boolean   @default(false)
  actorId         String
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  @@index([state, createdAt])
}

model RequirementHistory {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  at            DateTime    @default(now())
  actorId       String
  changeKind    String
  before        Json?
  after         Json?

  @@index([requirementId, at])
  @@index([actorId, at])
}

/// Append-only. Never pruned by history retention — spec 07 §6.
model AuditEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String
  spaceId    String?
  objectType String
  objectId   String
  operation  String
  parameters Json

  @@index([spaceId, at])
  @@index([objectType, objectId, at])
}
